<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- این اپ کاملاً آفلاین است؛ هیچ دسترسی اینترنتی لازم ندارد.
         این یکی فقط برای ذخیره در گالری روی اندروید ۹ و پایین‌تر لازم است
         (از اندروید ۱۰ به بعد نیازی به این مجوز نیست). -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="true"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MapOverlay">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- برای اشتراک‌گذاری/ذخیره‌ی فایل خروجی JPG بدون نیاز به دسترسی ذخیره‌سازی -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="ir.wtafkik.mapoverlay.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
