<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MapOverlay" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_teal</item>
        <item name="colorPrimaryDark">@color/accent_teal_dark</item>
        <item name="colorAccent">@color/accent_teal</item>
        <item name="android:windowBackground">@color/bg_top</item>
        <item name="materialButtonStyle">@style/Widget.MapOverlay.GlassButton</item>
    </style>

    <style name="Widget.MapOverlay.GlassButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/glass_fill</item>
        <item name="strokeColor">@color/glass_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="elevation">6dp</item>
        <item name="rippleColor">@color/accent_teal</item>
    </style>

    <style name="Widget.MapOverlay.GlassButton.Accent" parent="Widget.MapOverlay.GlassButton">
        <item name="backgroundTint">@color/accent_teal</item>
        <item name="strokeColor">@color/accent_teal_dark</item>
    </style>

    <style name="Widget.MapOverlay.GlassDialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:windowBackground">@drawable/glass_panel</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="colorAccent">@color/accent_teal</item>
    </style>

    <style name="Sample.Rounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>
</resources>
