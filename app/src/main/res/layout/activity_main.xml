<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- لایه‌ی ۱: پس‌زمینه‌ی گرادیانی -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient" />

    <!-- لایه‌ی ۳: محتوای اصلی -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="21sp"
                android:textStyle="bold" />

            <!-- نوار لوگوها: داخل جریان صفحه، پس هیچ‌وقت زیر دکمه/متن نمی‌رود -->
            <LinearLayout
                android:id="@+id/brandStrip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/logoWb"
                    android:layout_width="92dp"
                    android:layout_height="38dp"
                    android:layout_marginHorizontal="8dp"
                    android:alpha="0.55"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_weatherbell" />

                <ImageView
                    android:id="@+id/logoAseman"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginHorizontal="8dp"
                    android:alpha="0.65"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_aseman" />

                <ImageView
                    android:id="@+id/logoWu"
                    android:layout_width="92dp"
                    android:layout_height="38dp"
                    android:layout_marginHorizontal="8dp"
                    android:alpha="0.55"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_weatherus" />
            </LinearLayout>

            <!-- مرحله ۱: انتخاب سایت -->
            <LinearLayout
                android:id="@+id/siteContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible" />

            <!-- مرحله ۲: انتخاب زوم -->
            <LinearLayout
                android:id="@+id/zoomContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- مرحله ۳: انتخاب تصویر / در حال پردازش -->
            <LinearLayout
                android:id="@+id/processingContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/glass_panel"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/selectedZoomText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/pickImageButton"
                    style="@style/Widget.MapOverlay.GlassButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="10dp"
                    android:text="@string/pick_image" />

                <Button
                    android:id="@+id/pickFileButton"
                    style="@style/Widget.MapOverlay.GlassButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="10dp"
                    android:text="@string/pick_file" />

                <Button
                    android:id="@+id/pickBatchButton"
                    style="@style/Widget.MapOverlay.GlassButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="12dp"
                    android:text="@string/pick_batch" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:indeterminateTint="@color/accent_teal"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/processingText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/processing"
                    android:textColor="@color/text_secondary"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/backFromZoomButton"
                    style="@style/Widget.MapOverlay.GlassButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/back" />
            </LinearLayout>

            <!-- مرحله ۴: نتیجه -->
            <LinearLayout
                android:id="@+id/resultContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/glass_panel"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/previewImage"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:layout_marginBottom="12dp"
                    android:adjustViewBounds="true"
                    android:background="@drawable/glass_panel"
                    android:contentDescription="@null"
                    android:padding="6dp"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/resultDimsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:gravity="center"
                    android:textColor="@color/accent_teal"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/scaledDownNotice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:gravity="center"
                    android:text="@string/scaled_down_notice"
                    android:textColor="@color/warn_amber"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/saveShareButton"
                    style="@style/Widget.MapOverlay.GlassButton.Accent"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="10dp"
                    android:text="@string/save_share" />

                <Button
                    android:id="@+id/newImageButton"
                    style="@style/Widget.MapOverlay.GlassButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="10dp"
                    android:text="@string/new_image" />

                <Button
                    android:id="@+id/backFromResultButton"
                    style="@style/Widget.MapOverlay.GlassButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/back" />
            </LinearLayout>


            <!-- نمونه‌کار: در صفحه‌ی اصلی هر دو کنار هم، در صفحات هر سایت فقط نمونه‌ی همان سایت -->
            <LinearLayout
                android:id="@+id/sampleSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/sampleTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:gravity="center"
                    android:text="@string/sample_title"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/sampleRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/spacerStart"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="0.5"
                        android:visibility="gone" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/sampleWb"
                        android:layout_width="0dp"
                        android:layout_height="280dp"
                        android:layout_marginHorizontal="5dp"
                        android:layout_weight="1"
                        android:alpha="0.9"
                        android:contentDescription="@null"
                        android:padding="1dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/sample_weatherbell"
                        app:shapeAppearanceOverlay="@style/Sample.Rounded"
                        app:strokeColor="@color/glass_stroke"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/sampleWu"
                        android:layout_width="0dp"
                        android:layout_height="280dp"
                        android:layout_marginHorizontal="5dp"
                        android:layout_weight="1"
                        android:alpha="0.9"
                        android:contentDescription="@null"
                        android:padding="1dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/sample_weatherus"
                        app:shapeAppearanceOverlay="@style/Sample.Rounded"
                        app:strokeColor="@color/glass_stroke"
                        app:strokeWidth="1dp" />

                    <View
                        android:id="@+id/spacerEnd"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="0.5"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- دکمه‌ی «درباره ما» پایین صفحه‌ی اصلی (بیرون از ScrollView تا هیچ‌وقت روی محتوا نیفتد) -->
    <TextView
        android:id="@+id/infoButton"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/glass_pill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minWidth="150dp"
        android:paddingHorizontal="28dp"
        android:text="@string/about_us"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />
    </LinearLayout>


    <!-- لایه‌ی ۵: پیام خوش‌آمدگویی اولیه -->
    <FrameLayout
        android:id="@+id/splashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC0F1B2B"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/glass_panel"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/welcome_title"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/welcome_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
