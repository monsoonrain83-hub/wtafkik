<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- لایه‌ی ۱: پس‌زمینه‌ی گرادیانی -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient" />

    <!-- لایه‌ی ۲: واترمارک لوگوها -->
    <FrameLayout
        android:id="@+id/watermarkLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/watermarkAseman"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_gravity="center"
            android:alpha="0.16"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_aseman" />

        <ImageView
            android:id="@+id/watermarkWb"
            android:layout_width="220dp"
            android:layout_height="110dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="90dp"
            android:alpha="0.14"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_weatherbell" />

        <ImageView
            android:id="@+id/watermarkWu"
            android:layout_width="220dp"
            android:layout_height="90dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="70dp"
            android:alpha="0.14"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_weatherus" />
    </FrameLayout>

    <!-- لایه‌ی ۳: محتوای اصلی -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="21sp"
                android:textStyle="bold" />

            <!-- مرحله ۱: انتخاب سایت -->
            <LinearLayout
                android:id="@+id/siteContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible" />

            <!-- مرحله ۲: انتخاب زوم -->
            <LinearLayout
                android:id="@+id/zoomContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- مرحله ۳: انتخاب تصویر / در حال پردازش -->
            <LinearLayout
                android:id="@+id/processingContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/glass_panel"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/selectedZoomText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/pickImageButton"
                    style="@style/Widget.MapOverlay.GlassButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="10dp"
                    android:text="@string/pick_image" />

                <Button
                    android:id="@+id/pickFileButton"
                    style="@style/Widget.MapOverlay.GlassButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="12dp"
                    android:text="@string/pick_file" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:indeterminateTint="@color/accent_teal"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/processingText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/processing"
                    android:textColor="@color/text_secondary"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/backFromZoomButton"
                    style="@style/Widget.MapOverlay.GlassButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/back" />
            </LinearLayout>

            <!-- مرحله ۴: نتیجه -->
            <LinearLayout
                android:id="@+id/resultContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/glass_panel"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/previewImage"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:layout_marginBottom="12dp"
                    android:adjustViewBounds="true"
                    android:background="@drawable/glass_panel"
                    android:contentDescription="@null"
                    android:padding="6dp"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/resultDimsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:gravity="center"
                    android:textColor="@color/accent_teal"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/scaledDownNotice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:gravity="center"
                    android:text="@string/scaled_down_notice"
                    android:textColor="@color/warn_amber"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/saveShareButton"
                    style="@style/Widget.MapOverlay.GlassButton.Accent"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="10dp"
                    android:text="@string/save_share" />

                <Button
                    android:id="@+id/newImageButton"
                    style="@style/Widget.MapOverlay.GlassButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="10dp"
                    android:text="@string/new_image" />

                <Button
                    android:id="@+id/backFromResultButton"
                    style="@style/Widget.MapOverlay.GlassButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/back" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- لایه‌ی ۴: دکمه‌ی اطلاعات سازنده -->
    <TextView
        android:id="@+id/infoButton"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/glass_circle"
        android:gravity="center"
        android:text="i"
        android:textColor="@color/text_primary"
        android:textStyle="bold|italic"
        android:textSize="18sp" />

    <!-- لایه‌ی ۵: پیام خوش‌آمدگویی اولیه -->
    <FrameLayout
        android:id="@+id/splashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC0F1B2B"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/glass_panel"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/welcome_title"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/welcome_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
