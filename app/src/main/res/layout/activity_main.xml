<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="@string/app_name"
            android:textColor="@color/brand_green_dark"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- مرحله ۱: انتخاب سایت -->
        <LinearLayout
            android:id="@+id/siteContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible" />

        <!-- مرحله ۲: انتخاب زوم -->
        <LinearLayout
            android:id="@+id/zoomContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

        <!-- مرحله ۳: انتخاب تصویر / در حال پردازش -->
        <LinearLayout
            android:id="@+id/processingContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/selectedZoomText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:textColor="@color/brand_green_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/pickImageButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="10dp"
                android:backgroundTint="@color/brand_green"
                android:text="@string/pick_image"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/pickFileButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="@color/brand_green"
                android:text="@string/pick_file"
                android:textColor="@color/white" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/processingText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/processing"
                android:visibility="gone" />

            <Button
                android:id="@+id/backFromZoomButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/brand_green_dark"
                android:text="@string/back"
                android:textColor="@color/white" />
        </LinearLayout>

        <!-- مرحله ۴: نتیجه -->
        <LinearLayout
            android:id="@+id/resultContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/previewImage"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginBottom="10dp"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/resultDimsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:gravity="center"
                android:textColor="@color/brand_green_dark" />

            <TextView
                android:id="@+id/scaledDownNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center"
                android:text="@string/scaled_down_notice"
                android:textColor="#B45309"
                android:visibility="gone" />

            <Button
                android:id="@+id/saveShareButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="10dp"
                android:backgroundTint="@color/brand_green"
                android:text="@string/save_share"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/newImageButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:backgroundTint="@color/brand_green_dark"
                android:text="@string/new_image"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/backFromResultButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:backgroundTint="#777777"
                android:text="@string/back"
                android:textColor="@color/white" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
